<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Keep the generated C# visible so it can be explored in the playground. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="ParcelCount.unitsnet.json"
                     UnitsNetDefinition="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The playground exercises the generator source from this checkout. -->
    <ProjectReference Include="../../UnitsNet.Modular/UnitsNet.Modular.csproj" />
    <ProjectReference Include="../../UnitsNet.Modular.Generator/UnitsNet.Modular.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
