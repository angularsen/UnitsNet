      "BaseUnits": {
        "L": "Foot",
        "M": "Pound"
      },
      "FromUnitToBaseFunc": "{x} * 0.028316846592 / 0.45359237",
      "FromBaseToUnitFunc": "{x} * 0.45359237 / 0.028316846592",
      "Prefixes": [],
