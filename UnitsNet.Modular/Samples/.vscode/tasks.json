{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Samples: build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/UnitsNet.Modular.Samples.slnx",
        "--configuration",
        "Debug",
        "-p:Platform=ProjectReferences",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Samples: refresh local packages",
      "command": "pwsh",
      "type": "process",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/refresh-local-packages.ps1"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
